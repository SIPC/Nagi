using System;
using System.IO;
using System.Security.Cryptography;
public static class NagiCtr1 {
    public static byte[] Hex(string s) {
        byte[] b = new byte[s.Length / 2];
        for (int i = 0; i < b.Length; i++) b[i] = Convert.ToByte(s.Substring(i * 2, 2), 16);
        return b;
    }
    public static long Length(string path) {
        return File.Exists(path) ? new FileInfo(path).Length : 0;
    }
    // Append adds what one curl run received (tmp) to the segment file, then deletes tmp.
    public static void Append(string tmp, string part) {
        if (!File.Exists(tmp)) return;
        using (FileStream o = new FileStream(part, FileMode.Append, FileAccess.Write))
        using (FileStream i = new FileStream(tmp, FileMode.Open, FileAccess.Read)) { i.CopyTo(o); }
        File.Delete(tmp);
    }
    // Decrypt reads the segments in order and writes the AES-256-CTR plaintext. ecb: AES-ECB encryptor, no padding.
    // The counter is a 128-bit big-endian number starting at the IV, like openssl enc -aes-256-ctr.
    public static void Decrypt(string[] inputs, string output, ICryptoTransform ecb, string ivHex) {
        byte[] ctr = Hex(ivHex);
        const int B = 1 << 20;
        byte[] buf = new byte[B], blocks = new byte[B], ks = new byte[B];
        int next = 0;
        Stream cur = null;
        try {
            using (FileStream o = new FileStream(output, FileMode.Create, FileAccess.Write)) {
                while (true) {
                    int n = 0;
                    while (n < B) {
                        if (cur == null) {
                            if (next >= inputs.Length) break;
                            cur = new FileStream(inputs[next++], FileMode.Open, FileAccess.Read);
                        }
                        int r = cur.Read(buf, n, B - n);
                        if (r == 0) { cur.Dispose(); cur = null; continue; }
                        n += r;
                    }
                    if (n == 0) break;
                    int nb = (n + 15) / 16;
                    for (int j = 0; j < nb; j++) {
                        Buffer.BlockCopy(ctr, 0, blocks, j * 16, 16);
                        for (int k = 15; k >= 0; k--) { ctr[k]++; if (ctr[k] != 0) break; }
                    }
                    ecb.TransformBlock(blocks, 0, nb * 16, ks, 0);
                    for (int j = 0; j < n; j++) buf[j] ^= ks[j];
                    o.Write(buf, 0, n);
                    if (n < B) break;
                }
            }
        } finally {
            if (cur != null) cur.Dispose();
        }
    }
}
'@
}
function NagiWhy([int]$code, [string]$log) {
  $msg = ''; if ($log -and [IO.File]::Exists($log)) { $msg = [IO.File]::ReadAllText($log).Trim() }
  $http = ''; if ($msg -match 'error: (\d{3})') { $http = $Matches[1] }
  if ($code -eq 22 -and $http -eq '409') { return 'the file changed on the node: generate a new command in the panel' }
  if ($code -eq 22) { return 'the node rejected the link (expired, used from another network address, or used up): generate a new command in the panel' }
  if ($code -eq 23) { return 'cannot write the file (folder not writable or disk full)' }
  if ($code -in 5, 6, 7) { return 'cannot connect to the node (port blocked or node offline)' }
  if ($code -in 18, 28, 52, 55, 56) { return 'the connection was interrupted: run the command again to resume' }
  $r = 'curl.exe exited with ' + $code; if ($msg) { $r += ': ' + ($msg -split "`n")[-1].Trim() }; return $r
}
function NagiLen([string]$p) { try { $s = [IO.File]::Open($p, 'Open', 'Read', 'ReadWrite, Delete'); try { $s.Length } finally { $s.Dispose() } } catch { 0 } }
$seg = [long][math]::Max(1, [math]::Floor(($size + $N - 1) / $N))
$count = [int][math]::Ceiling($size / $seg)
$parts = @(for ($i = 0; $i -lt $count; $i++) { [IO.Path]::Combine($dir, $base + '.' + $N + '.part' + $i) })
$have = 0; foreach ($f in $parts) { [NagiCtr1]::Append($f + '.tmp', $f); $have += [NagiCtr1]::Length($f) }
$free = -1; try { $free = (New-Object IO.DriveInfo ([IO.Path]::GetPathRoot($o))).AvailableFreeSpace } catch { }
if ($free -ge 0 -and $free -lt 2 * $size - $have) { Write-Host ('FAILED: not enough disk space for ' + $o + ': ' + [math]::Ceiling((2 * $size - $have) / 1MB) + ' MiB needed, ' + [math]::Floor($free / 1MB) + ' MiB free'); return }
$errs = @()
for ($try = 0; $try -lt 3; $try++) {
  $run = @(); $errs = @(); $fatal = $false
  for ($i = 0; $i -lt $count; $i++) {
    $f = $parts[$i]; [NagiCtr1]::Append($f + '.tmp', $f)
    $a = $i * $seg; $e = [math]::Min($a + $seg, $size) - 1; $from = $a + [NagiCtr1]::Length($f)
    if ($from -gt $e) { continue }
    $p = Start-Process -FilePath curl.exe -ArgumentList @('-4', '-fgsS', '-r', ('{0}-{1}' -f $from, $e), '-o', ('"' + $f + '.tmp"'), '--stderr', ('"' + $f + '.log"'), $url) -NoNewWindow -PassThru
    $null = $p.Handle; $run += @{ p = $p; i = $i }
  }
  if ($run.Count -eq 0) { break }
  while (@($run | Where-Object { -not $_.p.HasExited }).Count -gt 0) {
    $got = 0; foreach ($f in $parts) { $got += (NagiLen $f) + (NagiLen ($f + '.tmp')) }
    Write-Host -NoNewline ("`r{0:N1} / {1:N1} MiB " -f ($got / 1MB), ($size / 1MB)); Start-Sleep -Milliseconds 500
  }
  Write-Host ''
  foreach ($r in $run) {
    $r.p.WaitForExit(); $code = $r.p.ExitCode
    if ($code -ne 0) { $errs += NagiWhy $code ($parts[$r.i] + '.log'); if ($code -in 22, 23) { $fatal = $true } }
  }
  if ($fatal) { break }
  if ($try -lt 2) { Start-Sleep -Seconds 1 }
}
$total = 0
foreach ($f in $parts) { [NagiCtr1]::Append($f + '.tmp', $f); $total += [NagiCtr1]::Length($f) }
if ($total -ne $size) {
  foreach ($m in @($errs | Select-Object -Unique)) { Write-Host ('FAILED: ' + $m) }
  Write-Host ('FAILED: download incomplete (' + $total + ' of ' + $size + ' bytes). Run the same command again within 5 minutes to resume; after that, generate a new command in the panel.'); return
}
$aes = [Security.Cryptography.Aes]::Create()
$aes.Mode = 'ECB'; $aes.Padding = 'None'; $aes.Key = [NagiCtr1]::Hex('16032e574efaafec7fe17092cf96c6385d115e0d07dbefd6ca0fe8324d7f7fa6')
try { [NagiCtr1]::Decrypt([string[]]$parts, $o, $aes.CreateEncryptor(), '432f9d55692b3550b434409a062c7b86') }
catch { Write-Host ('FAILED: cannot write ' + $o + ': ' + $_.Exception.GetBaseException().Message); return }
foreach ($f in $parts) { Remove-Item -LiteralPath $f; if ([IO.File]::Exists($f + '.log')) { [IO.File]::Delete($f + '.log') } }
if ([NagiCtr1]::Length($o) -ne $size) { Write-Host 'FAILED: the decrypted file has the wrong size'; return }
if ((Get-FileHash -LiteralPath $o -Algorithm SHA256).Hash -eq 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa') { 'SHA-256 OK' } else { Write-Host 'FAILED: SHA-256 mismatch'; return }
Write-Host ('Saved to ' + $o)
}
