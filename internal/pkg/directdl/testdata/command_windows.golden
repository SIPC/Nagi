$seg = [long][math]::Floor(($size + $N - 1) / $N)
$count = [int][math]::Ceiling($size / $seg)
$parts = @(for ($i = 0; $i -lt $count; $i++) { Join-Path $dir ($base + '.' + $N + '.part' + $i) })
for ($try = 0; $try -lt 3; $try++) {
  $run = @()
  for ($i = 0; $i -lt $count; $i++) {
    $f = $parts[$i]; [NagiCtr1]::Append($f + '.tmp', $f)
    $a = $i * $seg; $e = [math]::Min($a + $seg, $size) - 1; $from = $a + [NagiCtr1]::Length($f)
    if ($from -gt $e) { continue }
    $p = Start-Process -FilePath curl.exe -ArgumentList @('-6', '-fgsS', '-r', ('{0}-{1}' -f $from, $e), '-o', ('"' + $f + '.tmp"'), $url) -WorkingDirectory $dir -NoNewWindow -PassThru
    $null = $p.Handle; $run += $p
  }
  if ($run.Count -eq 0) { break }
  foreach ($p in $run) { $p.WaitForExit(); if ($p.ExitCode -ne 0) { Write-Host ('curl.exe exited with ' + $p.ExitCode) } }
  if ($try -lt 2) { Start-Sleep -Seconds 1 }
}
$total = 0
foreach ($f in $parts) { [NagiCtr1]::Append($f + '.tmp', $f); $total += [NagiCtr1]::Length($f) }
if ($total -ne $size) { Write-Host 'FAILED: download incomplete, run the command again to resume'; return }
$aes = [Security.Cryptography.Aes]::Create()
$aes.Mode = 'ECB'; $aes.Padding = 'None'; $aes.Key = [NagiCtr1]::Hex('16032e574efaafec7fe17092cf96c6385d115e0d07dbefd6ca0fe8324d7f7fa6')
$o = Join-Path $dir $out
[NagiCtr1]::Decrypt([string[]]$parts, $o, $aes.CreateEncryptor(), '432f9d55692b3550b434409a062c7b86')
foreach ($f in $parts) { Remove-Item -LiteralPath $f }
if ((Get-FileHash -LiteralPath $o -Algorithm SHA256).Hash -eq 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb') { 'SHA-256 OK' } else { Write-Host 'FAILED' }
}
